# GESTEK — Backend (Express)
# Copia este archivo como .env y completa los valores reales.

# Servidor
PORT=3000
NODE_ENV=development

# Supabase (service_role: backend-only, NUNCA exponer al frontend)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# JWT para los QR de boletas (Fase D — check-in)
QR_JWT_SECRET=cambia_esto_por_un_secreto_seguro_minimo_32_chars

# CORS
FRONTEND_URL=http://localhost:5173

# Sentry (opcional)
SENTRY_DSN=

# Mercado Pago — cuenta plataforma (GESTEK), usada para el plan Pro
MP_PLATFORM_ACCESS_TOKEN=APP_USR-...
MP_PLATFORM_PUBLIC_KEY=APP_USR-...
# Secret para validar la firma HMAC de los webhooks MP (panel del webhook → configurar firma)
MP_WEBHOOK_SECRET=
PLAN_PRO_PRICE_USD=19.99
PLAN_PRO_PRICE=79900
PLAN_PRO_CURRENCY=COP
PLAN_PRO_DURATION_DAYS=30
# Dejar en false en producción
ALLOW_DEV_PRO_ACTIVATION=false

# URL pública del backend (usada en notification_url de las preferences MP)
API_PUBLIC_URL=

# Web Push (VAPID) — generar con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@tu-dominio.com

# Email transaccional (notificación de tareas, etc.)
# Opción A — Gmail SMTP: crear App Password en https://myaccount.google.com/apppasswords
GMAIL_USER=tucuenta@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Opción B — Resend (si no usás Gmail): definir RESEND_API_KEY
RESEND_API_KEY=
EMAIL_FROM=GESTEK <tucuenta@gmail.com>

# ─── Seguridad ───
# Cloudflare Turnstile (captcha anti-bot). Opcional: sin esto no se exige captcha.
TURNSTILE_SECRET_KEY=
# Límite de boletas por email por evento
MAX_TICKETS_POR_EMAIL=5

# ─── Asistente IA (criatura "Gestek") ───
# Motor intercambiable. Define UNA de las 3 keys (o varias) y opcionalmente
# AGENTE_PROVIDER para forzar cuál usar. Sin ninguna key el asistente se
# deshabilita silenciosamente (el launcher no aparece, /me/agente/chat → 503).
#
# Opción gratuita A — Groq (capa gratis, rápido): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Opción gratuita B — Google Gemini (capa gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
#
# Opción de pago — Anthropic (mejor precisión, console.anthropic.com, NO es el Claude gratis)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-7
#
# Forzar proveedor: groq | gemini | anthropic (si se omite, usa el primero con key, gratis primero)
AGENTE_PROVIDER=
