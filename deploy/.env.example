# ─────────────────────────────────────────────────────────────────────────
# GESTEK · variables de entorno del backend (API)
# Copia a `.env` y rellena. En el VPS self-hosted, SUPABASE_URL apunta a tu
# propio Supabase; en Render/gestionado, al proyecto gestionado. Cambiar solo
# estas variables mueve toda la app — el código no cambia.
# ─────────────────────────────────────────────────────────────────────────

# ── Núcleo ──
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://gestekeventost.dpdns.org        # coma-separado si hay varios
API_PUBLIC_URL=https://api.tudominio.com             # URL pública del backend (para webhooks)
QR_JWT_SECRET=cambia-esto-por-un-secreto-largo       # firma los QR de las boletas

# ── Base de datos / Auth / Storage (Supabase, gestionado o self-hosted) ──
SUPABASE_URL=https://TU-PROYECTO.supabase.co         # o https://db.tudominio.com (self-host)
SUPABASE_SERVICE_KEY=service_role_key                # NUNCA exponer al frontend

# ── Correo (microservicio propio + fallbacks) ──
MAIL_SERVICE_URL=                                    # https://correo.tudominio.com (si se usa)
MAIL_SERVICE_KEY=
EMAIL_FROM="GESTEK <no-reply@tudominio.com>"
# Fallbacks directos (si no hay microservicio): cPanel SMTP / Resend / Gmail
CPANEL_SMTP_HOST=
CPANEL_SMTP_PORT=465
CPANEL_SMTP_USER=
CPANEL_SMTP_PASS=
RESEND_API_KEY=

# ── Pagos ──
# Mercado Pago (plataforma; las cuentas de organizador van por UI)
MP_PLATFORM_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Wompi: las llaves por-organizador se pegan en la UI (Comercial → Pagos).
# Webhook de eventos Wompi a configurar en su panel: {API_PUBLIC_URL}/webhooks/wompi

# ── KYC (Truora) ──
TRUORA_API_KEY=
TRUORA_API_BASE=https://api.validations.truora.com/v1
# Webhook Truora: {API_PUBLIC_URL}/webhooks/truora

# ── Google Calendar (OAuth) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.tudominio.com/integraciones/google/callback
GOOGLE_STATE_SECRET=cambia-esto

# ── Push (Web Push / VAPID) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:soporte@tudominio.com

# ── Anti-bot (Cloudflare Turnstile) ──
TURNSTILE_SECRET_KEY=

# ── IA (opcional; solo Groq tiene capa gratis) ──
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Observabilidad (opcional) ──
SENTRY_DSN=
