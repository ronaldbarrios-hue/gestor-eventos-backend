# GESTEK — Backend (Express)
# Copia este archivo como .env y completa los valores reales.

# Servidor
PORT=3000
NODE_ENV=development

# Supabase (service_role: backend-only, NUNCA exponer al frontend)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# JWT para los QR de boletas (Fase D — check-in)
QR_JWT_SECRET=cambia_esto_por_un_secreto_seguro_minimo_32_chars

# CORS
FRONTEND_URL=http://localhost:5173

# Sentry (opcional)
SENTRY_DSN=

# Mercado Pago — cuenta plataforma (GESTEK), usada para el plan Pro
MP_PLATFORM_ACCESS_TOKEN=APP_USR-...
MP_PLATFORM_PUBLIC_KEY=APP_USR-...
# Secret para validar la firma HMAC de los webhooks MP (panel del webhook → configurar firma)
MP_WEBHOOK_SECRET=
# Dejar en false en producción
ALLOW_DEV_PRO_ACTIVATION=false

# URL pública del backend (usada en notification_url de las preferences MP)
API_PUBLIC_URL=

# Web Push (VAPID) — generar con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@tu-dominio.com

# ─── Email transaccional ───
# Lo usan las boletas con QR, los recordatorios, las invitaciones al equipo, las
# tareas y las campañas del panel.
#
# Se elige UNA de las tres familias de opciones. El código las prueba en este
# orden y se queda con la primera completa: buzones SMTP de plataforma (A) →
# Gmail OAuth2 → Resend.
#
# SIN NINGUNA, los envíos se descartan en silencio: la compra de una
# boleta funciona y el correo no sale. El panel lo avisa en
# Event Experience → Emails, y GET /eventos/:id/emails/diagnostico lo dice.
#
# Antes aquí se pedía GMAIL_APP_PASSWORD, que el código no lee en ningún sitio
# —usa OAuth2, no contraseña de aplicación— y no se mencionaban las de cPanel,
# que son justo las de producción. Quien seguía este archivo se quedaba sin
# correo y sin saber por qué.

# Opción A — buzón(es) SMTP propio(s) del dominio. Es la de producción.
#
# Puedes poner UNO (el de abajo) o DOS (añadiendo el bloque «2»). Con los dos
# puestos, cada correo alterna entre ambos buzones —round-robin, uno por
# uno— para repartir la carga y sumar los dos límites por hora en vez de
# agotar el de uno solo. Si al que le toca el turno falla, se intenta con el
# otro antes de descartar el correo.

# A1 — primer buzón (por ejemplo, el de cPanel de tu propio hosting).
CPANEL_SMTP_USER=no-reply@tu-dominio.com
CPANEL_SMTP_PASS=
CPANEL_SMTP_HOST=mail.tu-dominio.com
# 465 = SSL directo; 587 = STARTTLS
CPANEL_SMTP_PORT=465

# A2 — segundo buzón, opcional (por ejemplo, Hostinger). Si lo dejas vacío,
# solo se usa el buzón A1 y nada cambia respecto a antes. El host de SMTP de
# Hostinger suele ser smtp.hostinger.com — confírmalo en tu hPanel → Correos →
# tu dominio → «Configurar cliente de correo», porque puede variar según cómo
# esté aprovisionada la cuenta.
CPANEL_SMTP_USER2=
CPANEL_SMTP_PASS2=
CPANEL_SMTP_HOST2=smtp.hostinger.com
CPANEL_SMTP_PORT2=465

# Opción B — Gmail con OAuth2 (las cuatro son obligatorias juntas).
# El refresh token se saca en https://developers.google.com/oauthplayground
# con el scope https://mail.google.com/
GMAIL_USER=tucuenta@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Opción C — Resend (https://resend.com). Solo hace falta la llave.
RESEND_API_KEY=

# Remitente que se muestra. Si se deja vacío se arma con el usuario de arriba.
EMAIL_FROM=GESTEK <no-reply@tu-dominio.com>

# Remitente del BUZÓN 2, si tienes dos. Cada buzón sólo puede mandar como su
# propia dirección — proveedores como Hostinger rechazan el correo si el
# remitente no es el mismo buzón autenticado ("Sender address rejected: not
# owned by..."). Si la dejas vacía, se usa CPANEL_SMTP_USER2 tal cual, que es
# justo la dirección que el proveedor sí acepta.
EMAIL_FROM2=

# Microservicio de correo (opcional). Con MAIL_SERVICE_URL puesta, el backend
# solo valida permisos y delega el envío. Sin ella envía él mismo.
MAIL_SERVICE_URL=
MAIL_SERVICE_KEY=

# ─── Seguridad ───
# Cloudflare Turnstile (captcha anti-bot). Opcional: sin esto no se exige captcha.
TURNSTILE_SECRET_KEY=
# Límite de boletas por email por evento
MAX_TICKETS_POR_EMAIL=5

# ─── Asistente IA (criatura "Gestek") ───
# Motor intercambiable. Define UNA de las 3 keys (o varias) y opcionalmente
# AGENTE_PROVIDER para forzar cuál usar. Sin ninguna key el asistente se
# deshabilita silenciosamente (el launcher no aparece, /me/agente/chat → 503).
#
# Opción gratuita A — Groq (capa gratis, rápido): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Opción gratuita B — Google Gemini (capa gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
#
# Opción de pago — Anthropic (mejor precisión, console.anthropic.com, NO es el Claude gratis)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
#
# Forzar proveedor: groq | gemini | anthropic (si se omite, usa el primero con key, gratis primero)
AGENTE_PROVIDER=

# ─── Google Calendar (opcional) ───
# Crear el evento de una entrevista en el calendario del organizador e invitar
# al candidato. Sin GOOGLE_CLIENT_ID la integración queda inerte: no falla, no
# aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/google/callback
# Firma el `state` del OAuth para poder validar la vuelta.
GOOGLE_STATE_SECRET=

# ─── Truora · verificación facial KYC (opcional) ───
# Verifica la identidad en el perfil de talento. Inerte sin la key.
TRUORA_API_KEY=
# TRUORA_API_BASE=https://api.validations.truora.com

# ─── URLs y firmas ───
# URL PÚBLICA de este backend. La usan los back_urls de las pasarelas de pago:
# sin ella cae a http://localhost:3000 y un pago en producción devolvería al
# usuario a localhost.
BACKEND_URL=
# Firma de tokens propios del backend.
JWT_SECRET=

# ─── Ajustes con valor por defecto ───
# Solo se tocan para afinar; el código funciona sin ellas.
# Websockets (chat en vivo). 'false' los desactiva.
# ENABLE_SOCKETS=true
# Límites de petición: cuántas y en qué ventana (ms).
# RATE_LIMIT_API_MAX=120
# RATE_LIMIT_API_WINDOW=60000
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW=60000
